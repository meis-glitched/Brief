# Path to the local SQLite database. Leave unset to use the environment default:
# local: ./data/brief.db
# Vercel: /tmp/brief/data/brief.db (ephemeral; set explicitly for a persistent volume)
# BRIEF_DB_PATH=./data/brief.db

# Optional local model for the daily brief.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=dolphin3:8b

# Story clustering. Raise the threshold for tighter clusters.
BRIEF_CLUSTER_THRESHOLD=0.42
BRIEF_CLUSTER_MIN_SHARED=2

# On-disk cache for proxied article images.
BRIEF_IMAGE_CACHE_MB=500

# Wikipedia cache windows and limits.
BRIEF_WIKI_CACHE_DAYS=30
BRIEF_WIKI_SEARCH_CACHE_HOURS=24
BRIEF_WIKI_LEAD_CACHE_DAYS=30
BRIEF_WIKI_CACHE_PAGES=1000
BRIEF_WIKI_LEAD_CACHE=5000
BRIEF_WIKI_SEARCH_CACHE=500

# Source DB for `npm run import:legacy`.
# LEGACY_DB=/path/to/news.db
